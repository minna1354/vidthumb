"use client";

import { useState, useRef, useCallback, useEffect, useMemo } from "react";

const TARGET_SIZE = { width: 1280, height: 720 };
const MAX_FILE_SIZE = 10 * 1024 * 1024;
const MIN_ZOOM = 0.5;
const MAX_ZOOM = 4;
const ZOOM_STEP = 0.1;
const ROTATE_STEP = 15;

type TextPosition = "top" | "center" | "bottom";
type ExportFormat = "png" | "jpeg";

interface ImageState {
  url: string;
  width: number;
  height: number;
  file: File;
}

interface Platform {
  id: string;
  name: string;
  width: number;
  height: number;
}

const PLATFORMS: Platform[] = [
  { id: "youtube", name: "YouTube", width: 1280, height: 720 },
  { id: "shorts", name: "Shorts", width: 1080, height: 1920 },
  { id: "tiktok", name: "TikTok", width: 1080, height: 1920 },
  { id: "instagram", name: "Instagram", width: 1080, height: 1080 },
];

function drawToCanvas(
  canvas: HTMLCanvasElement,
  size: { width: number; height: number },
  opts: {
    bgColor: string;
    image: HTMLImageElement | null;
    textOverlay: string;
    textColor: string;
    textSize: number;
    textPosition: TextPosition;
    offset: { x: number; y: number };
    zoom: number;
  }
) {
  const ctx = canvas.getContext("2d");
  if (!ctx) return;
  canvas.width = size.width;
  canvas.height = size.height;
  ctx.fillStyle = opts.bgColor;
  ctx.fillRect(0, 0, size.width, size.height);
  if (!opts.image) return;
  const baseScale = Math.max(size.width / opts.image.width, size.height / opts.image.height);
  const finalScale = baseScale * opts.zoom;
  const scaledW = opts.image.width * finalScale;
  const scaledH = opts.image.height * finalScale;
  const baseX = (size.width - scaledW) / 2;
  const baseY = (size.height - scaledH) / 2;
  const sx = size.width / TARGET_SIZE.width;
  const sy = size.height / TARGET_SIZE.height;
  ctx.drawImage(opts.image, baseX + opts.offset.x * sx, baseY + opts.offset.y * sy, scaledW, scaledH);
  if (opts.textOverlay.trim()) {
    const tScale = Math.min(sx, sy);
    const tSize = opts.textSize * tScale;
    ctx.font = `bold ${tSize}px "Inter", system-ui, -apple-system, sans-serif`;
    ctx.fillStyle = opts.textColor;
    ctx.strokeStyle = "#000000";
    ctx.lineWidth = Math.max(tSize / 12, 4);
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    let yPos: number;
    if (opts.textPosition === "top") yPos = tSize + 30 * tScale;
    else if (opts.textPosition === "center") yPos = size.height / 2;
    else yPos = size.height - tSize - 30 * tScale;
    const maxWidth = size.width - 80 * sx;
    const words = opts.textOverlay.split(" ");
    const lines: string[] = [];
    let currentLine = words[0] || "";
    for (let i = 1; i < words.length; i++) {
      const testLine = currentLine + " " + words[i];
      const metrics = ctx.measureText(testLine);
      if (metrics.width > maxWidth && currentLine) {
        lines.push(currentLine);
        currentLine = words[i];
      } else {
        currentLine = testLine;
      }
    }
    lines.push(currentLine);
    const lineHeight = tSize * 1.1;
    const totalHeight = lines.length * lineHeight;
    let startY = yPos - (totalHeight - lineHeight) / 2;
    lines.forEach((line, i) => {
      const lineY = startY + i * lineHeight;
      ctx.strokeText(line, size.width / 2, lineY);
      ctx.fillText(line, size.width / 2, lineY);
    });
  }
}

function downloadCanvas(canvas: HTMLCanvasElement, fileName: string, format: ExportFormat, quality: number): Promise<void> {
  return new Promise((resolve, reject) => {
    canvas.toBlob(
      (blob) => {
        if (!blob) return reject(new Error("toBlob failed"));
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        resolve();
      },
      format === "jpeg" ? "image/jpeg" : "image/png",
      format === "jpeg" ? quality : undefined
    );
  });
}

export default function ThumbnailEditor() {  const [image, setImage] = useState<ImageState | null>(null);
  const [workingImage, setWorkingImage] = useState<HTMLImageElement | null>(null);
  const [rotation, setRotation] = useState(0);
  const [flipH, setFlipH] = useState(false);
  const [flipV, setFlipV] = useState(false);
  const [offset, setOffset] = useState({ x: 0, y: 0 });
  const [zoom, setZoom] = useState(1.0);
  const [isDragging, setIsDragging] = useState(false);
  const [textOverlay, setTextOverlay] = useState("");
  const [textColor, setTextColor] = useState("#ffffff");
  const [textSize, setTextSize] = useState(72);
  const [textPosition, setTextPosition] = useState<TextPosition>("bottom");
  const [bgColor, setBgColor] = useState("#000000");
  const [format, setFormat] = useState<ExportFormat>("png");
  const [quality, setQuality] = useState(0.92);
  const [selectedPlatforms, setSelectedPlatforms] = useState<string[]>(["youtube"]);
  const [error, setError] = useState<string | null>(null);
  const [processing, setProcessing] = useState(false);

  const canvasRef = useRef<HTMLCanvasElement>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const previewContainerRef = useRef<HTMLDivElement>(null);
  const dragStartRef = useRef({ mouseX: 0, mouseY: 0, offsetX: 0, offsetY: 0 });

  const drawOpts = useMemo(
    () => ({ bgColor, image: workingImage, textOverlay, textColor, textSize, textPosition, offset, zoom }),
    [bgColor, workingImage, textOverlay, textColor, textSize, textPosition, offset, zoom]
  );

  useEffect(() => {
    return () => { if (image?.url) URL.revokeObjectURL(image.url); };
  }, [image]);

  useEffect(() => {
    setRotation(0); setFlipH(false); setFlipV(false); setOffset({ x: 0, y: 0 }); setZoom(1.0); setTextOverlay("");
  }, [image]);

  useEffect(() => {
    if (!image) { setWorkingImage(null); return; }
    let cancelled = false;
    const orig = new Image();
    orig.onload = () => {
      if (cancelled) return;
      const noTransform = rotation === 0 && !flipH && !flipV;
      if (noTransform) { setWorkingImage(orig); return; }
      // Arbitrary rotation: compute exact bounding box using trig
      const angleRad = (rotation * Math.PI) / 180;
      const cosA = Math.abs(Math.cos(angleRad));
      const sinA = Math.abs(Math.sin(angleRad));
      const w = Math.ceil(orig.width * cosA + orig.height * sinA);
      const h = Math.ceil(orig.width * sinA + orig.height * cosA);
      const tmp = document.createElement("canvas");
      tmp.width = w;
      tmp.height = h;
      const ctx = tmp.getContext("2d");
      if (!ctx) return;
      ctx.translate(w / 2, h / 2);
      ctx.rotate(angleRad);
      ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
      ctx.drawImage(orig, -orig.width / 2, -orig.height / 2);
      const transformed = new Image();
      transformed.onload = () => { if (!cancelled) setWorkingImage(transformed); };
      transformed.src = tmp.toDataURL();
    };
    orig.src = image.url;
    return () => { cancelled = true; };
  }, [image, rotation, flipH, flipV]);

  useEffect(() => {
    if (!workingImage || !canvasRef.current) return;
    setProcessing(true);
    drawToCanvas(canvasRef.current, TARGET_SIZE, drawOpts);
    setProcessing(false);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [drawOpts]);  const handleFile = useCallback((file: File) => {
    setError(null);
    if (!file.type.startsWith("image/")) { setError("Please upload an image file."); return; }
    if (file.size > MAX_FILE_SIZE) { setError("File too large. Max 10MB."); return; }
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => setImage({ url, width: img.width, height: img.height, file });
    img.onerror = () => { setError("Failed to load image."); URL.revokeObjectURL(url); };
    img.src = url;
  }, []);
  const handleDrop = useCallback((e: React.DragEvent) => { e.preventDefault(); const f = e.dataTransfer.files[0]; if (f) handleFile(f); }, [handleFile]);
  const handleDragOver = useCallback((e: React.DragEvent) => { e.preventDefault(); }, []);

  const handlePreviewPointerDown = useCallback((e: React.MouseEvent | React.TouchEvent) => {
    if (!previewContainerRef.current) return;
    const point = "touches" in e ? e.touches[0] : e;
    setIsDragging(true);
    dragStartRef.current = { mouseX: point.clientX, mouseY: point.clientY, offsetX: offset.x, offsetY: offset.y };
  }, [offset]);

  useEffect(() => {
    if (!isDragging) return;
    const handleMove = (e: MouseEvent | TouchEvent) => {
      if (!previewContainerRef.current) return;
      const point = "touches" in e ? e.touches[0] : e;
      const rect = previewContainerRef.current.getBoundingClientRect();
      const scale = TARGET_SIZE.width / rect.width;
      const canvasDx = (point.clientX - dragStartRef.current.mouseX) * scale;
      const canvasDy = (point.clientY - dragStartRef.current.mouseY) * scale;
      setOffset({ x: dragStartRef.current.offsetX + canvasDx, y: dragStartRef.current.offsetY + canvasDy });
    };
    const handleUp = () => setIsDragging(false);
    window.addEventListener("mousemove", handleMove);
    window.addEventListener("mouseup", handleUp);
    window.addEventListener("touchmove", handleMove, { passive: false });
    window.addEventListener("touchend", handleUp);
    return () => {
      window.removeEventListener("mousemove", handleMove);
      window.removeEventListener("mouseup", handleUp);
      window.removeEventListener("touchmove", handleMove);
      window.removeEventListener("touchend", handleUp);
    };
  }, [isDragging]);

  useEffect(() => {
    const el = previewContainerRef.current;
    if (!el) return;
    const handleWheel = (e: WheelEvent) => {
      e.preventDefault();
      const direction = e.deltaY < 0 ? 1 : -1;
      const factor = 1 + direction * ZOOM_STEP;
      setZoom((prev) => Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, prev * factor)));
    };
    el.addEventListener("wheel", handleWheel, { passive: false });
    return () => el.removeEventListener("wheel", handleWheel);
  }, [image]);

  const zoomIn = useCallback(() => setZoom((p) => Math.min(MAX_ZOOM, p + ZOOM_STEP * 2)), []);
  const zoomOut = useCallback(() => setZoom((p) => Math.max(MIN_ZOOM, p - ZOOM_STEP * 2)), []);
  const rotateCW = useCallback(() => setRotation((r) => (r + ROTATE_STEP) % 360), []);
  const rotateCCW = useCallback(() => setRotation((r) => (r - ROTATE_STEP + 360) % 360), []);
  const toggleFlipH = useCallback(() => setFlipH((f) => !f), []);
  const toggleFlipV = useCallback(() => setFlipV((f) => !f), []);
  const handleResetPosition = useCallback(() => { setOffset({ x: 0, y: 0 }); setZoom(1.0); }, []);
  const handleResetTransforms = useCallback(() => { setRotation(0); setFlipH(false); setFlipV(false); }, []);
  const togglePlatform = useCallback((id: string) => {
    setSelectedPlatforms((prev) => prev.includes(id) ? prev.filter((p) => p !== id) : [...prev, id]);
  }, []);

  const handleDownloadAll = useCallback(async () => {
    if (!workingImage) return;
    if (selectedPlatforms.length === 0) { setError("Please select at least one platform."); return; }
    setProcessing(true);
    try {
      for (let i = 0; i < selectedPlatforms.length; i++) {
        const platform = PLATFORMS.find((p) => p.id === selectedPlatforms[i]);
        if (!platform) continue;
        const tempCanvas = document.createElement("canvas");
        drawToCanvas(tempCanvas, { width: platform.width, height: platform.height }, drawOpts);
        const ext = format === "jpeg" ? "jpg" : "png";
        await downloadCanvas(tempCanvas, `vidthumb-${platform.id}-${platform.width}x${platform.height}.${ext}`, format, quality);
        if (i < selectedPlatforms.length - 1) await new Promise((r) => setTimeout(r, 300));
      }
    } catch (e) { setError("Download failed."); } finally { setProcessing(false); }
  }, [workingImage, selectedPlatforms, format, quality, drawOpts]);

  useEffect(() => {
    if (!image) return;
    const handleKey = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      if (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable) return;
      if (e.key === "r" || e.key === "R") { e.preventDefault(); if (e.shiftKey) rotateCCW(); else rotateCW(); }
      else if (e.key === "h" || e.key === "H") toggleFlipH();
      else if (e.key === "v" || e.key === "V") toggleFlipV();
      else if (e.key === "+" || e.key === "=") zoomIn();
      else if (e.key === "-" || e.key === "_") zoomOut();
      else if (e.key === "0") handleResetPosition();
    };
    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [image, rotateCW, rotateCCW, toggleFlipH, toggleFlipV, zoomIn, zoomOut, handleResetPosition]);

  const handleReset = useCallback(() => {
    if (image?.url) URL.revokeObjectURL(image.url);
    setImage(null); setTextOverlay(""); setTextColor("#ffffff"); setTextSize(72);
    setTextPosition("bottom"); setError(null);
  }, [image]);

  const aspectOK = image && image.width === TARGET_SIZE.width && image.height === TARGET_SIZE.height;
  const positionChanged = offset.x !== 0 || offset.y !== 0 || zoom !== 1.0;
  const transformChanged = rotation !== 0 || flipH || flipV;
  const zoomPercent = Math.round(zoom * 100);
  const platformLabel = useMemo(() => {
    if (selectedPlatforms.length === 0) return "None";
    if (selectedPlatforms.length === 1) return PLATFORMS.find((p) => p.id === selectedPlatforms[0])?.name || "";
    return `${selectedPlatforms.length} platforms`;
  }, [selectedPlatforms]);
  if (!image) {
    return (
      <div>
        <div
          onDrop={handleDrop}
          onDragOver={handleDragOver}
          onClick={() => fileInputRef.current?.click()}
          role="button"
          tabIndex={0}
          onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileInputRef.current?.click(); } }}
          className="border-2 border-dashed border-gray-300 rounded-2xl p-12 md:p-16 text-center cursor-pointer hover:border-purple-500 hover:bg-purple-50/30 transition-all"
        >
          <input ref={fileInputRef} type="file" accept="image/jpeg,image/png,image/webp"
            onChange={(e) => { const f = e.target.files?.[0]; if (f) handleFile(f); }}
            className="hidden" aria-label="Upload image" />
          <div className="text-5xl mb-4">Drop here</div>
          <p className="text-xl md:text-2xl font-bold mb-2 text-gray-800">Drop your image here</p>
          <p className="text-gray-500 mb-4">or click to browse</p>
          <div className="flex flex-wrap justify-center gap-2 text-xs text-gray-400">
            <span className="px-3 py-1 bg-gray-100 rounded-full">JPG</span>
            <span className="px-3 py-1 bg-gray-100 rounded-full">PNG</span>
            <span className="px-3 py-1 bg-gray-100 rounded-full">WebP</span>
            <span className="px-3 py-1 bg-gray-100 rounded-full">Max 10MB</span>
          </div>
          <p className="mt-6 text-xs text-gray-400">Your images never leave your browser</p>
        </div>
        {error && <div className="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">{error}</div>}
      </div>
    );
  }  return (
    <div>
      <div className="mb-4 flex flex-wrap items-center justify-between gap-2 text-sm">
        <div className="flex items-center gap-3">
          <span className={"px-3 py-1 rounded-full text-xs font-medium " + (aspectOK ? "bg-green-100 text-green-700" : "bg-amber-100 text-amber-700")}>
            {aspectOK ? "Perfect size" : "Needs resize"}
          </span>
          <span className="text-gray-500">Original: {image.width}x{image.height}</span>
        </div>
        <button onClick={handleReset} className="text-gray-500 hover:text-gray-700 text-sm underline">
          Upload different image
        </button>
      </div>

      {error && <div className="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">{error}</div>}

      <div className="grid lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold mb-2 text-sm text-gray-500 uppercase tracking-wide">Original</h3>
          <div className="bg-gray-100 rounded-xl overflow-hidden aspect-video flex items-center justify-center">
            <img src={image.url} alt="Original" className="max-w-full max-h-full object-contain" />
          </div>
        </div>

        <div>
          <div className="flex items-center justify-between mb-2">
            <h3 className="font-bold text-sm text-gray-500 uppercase tracking-wide">Preview ({TARGET_SIZE.width}x{TARGET_SIZE.height})</h3>
            {positionChanged && <button onClick={handleResetPosition} className="text-xs text-purple-600 hover:text-purple-800 underline">Reset position</button>}
          </div>
          <div ref={previewContainerRef}
            onMouseDown={handlePreviewPointerDown}
            onTouchStart={handlePreviewPointerDown}
            className={"bg-gray-100 rounded-xl overflow-hidden aspect-video relative select-none " + (isDragging ? "cursor-grabbing" : "cursor-grab")}
            style={{ touchAction: "none" }}>
            <canvas ref={canvasRef} className="w-full h-full pointer-events-none" style={{ display: "block" }} />
            {processing && <div className="absolute inset-0 flex items-center justify-center bg-black/30 text-white text-sm pointer-events-none">Processing...</div>}
            <div className="absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded pointer-events-none font-mono">Zoom {zoomPercent}%</div>
            {!isDragging && !processing && <div className="absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded pointer-events-none">Drag - Scroll - R/H/V/+/-</div>}
          </div>

          <div className="mt-2 flex flex-wrap items-center justify-center gap-2">
            <button onClick={zoomOut} disabled={zoom <= MIN_ZOOM} className="w-8 h-8 rounded border border-gray-300 hover:border-purple-500 disabled:opacity-30" title="Zoom out">-</button>
            <input type="range" min={MIN_ZOOM * 100} max={MAX_ZOOM * 100} value={zoomPercent} onChange={(e) => setZoom(Number(e.target.value) / 100)} className="w-20" />
            <button onClick={zoomIn} disabled={zoom >= MAX_ZOOM} className="w-8 h-8 rounded border border-gray-300 hover:border-purple-500 disabled:opacity-30" title="Zoom in">+</button>
            <div className="w-px h-6 bg-gray-300 mx-1" />
            <button onClick={rotateCCW} className="w-8 h-8 rounded border border-gray-300 hover:border-purple-500" title="Rotate left 15 deg">{"<-"}</button>
            <input type="range" min={0} max={359} value={rotation} onChange={(e) => setRotation(Number(e.target.value))} className="w-20" aria-label="Rotation angle" title="Drag to rotate any angle" />
            <span className="text-sm font-mono w-10 text-center">{rotation}deg</span>
            <button onClick={rotateCW} className="w-8 h-8 rounded border border-gray-300 hover:border-purple-500" title="Rotate right 15 deg">{"->"}</button>
            <div className="w-px h-6 bg-gray-300 mx-1" />
            <button onClick={toggleFlipH} className={"w-8 h-8 rounded border " + (flipH ? "bg-purple-600 text-white border-purple-600" : "border-gray-300 hover:border-purple-500")} title="Flip horizontal (H)">{"<->"}</button>
            <button onClick={toggleFlipV} className={"w-8 h-8 rounded border " + (flipV ? "bg-purple-600 text-white border-purple-600" : "border-gray-300 hover:border-purple-500")} title="Flip vertical (V)">Flip V</button>
            {transformChanged && <button onClick={handleResetTransforms} className="text-xs text-purple-600 hover:text-purple-800 underline ml-1">Reset</button>}
          </div>
        </div>
      </div>      <div className="mt-8 bg-white border border-gray-200 rounded-xl p-6">
        <h3 className="font-bold mb-4">Customize</h3>
        <div className="space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Text overlay (optional)</label>
            <input type="text" value={textOverlay} onChange={(e) => setTextOverlay(e.target.value)}
              placeholder="e.g. How to make THUMBNAILS" maxLength={50}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500" />
          </div>
          {textOverlay.trim() && (
            <div className="grid sm:grid-cols-3 gap-4 pl-1">
              <div>
                <label className="block text-xs font-medium text-gray-600 mb-1">Color</label>
                <div className="flex gap-2">
                  <input type="color" value={textColor} onChange={(e) => setTextColor(e.target.value)} className="w-10 h-10 rounded cursor-pointer border border-gray-300" />
                  <input type="text" value={textColor} onChange={(e) => setTextColor(e.target.value)} className="flex-1 px-2 py-1 text-sm border border-gray-300 rounded font-mono" />
                </div>
              </div>
              <div>
                <label className="block text-xs font-medium text-gray-600 mb-1">Size: {textSize}px</label>
                <input type="range" min={24} max={120} value={textSize} onChange={(e) => setTextSize(Number(e.target.value))} className="w-full" />
              </div>
              <div>
                <label className="block text-xs font-medium text-gray-600 mb-1">Position</label>
                <div className="flex gap-1">
                  {(["top", "center", "bottom"] as TextPosition[]).map((pos) => (
                    <button key={pos} onClick={() => setTextPosition(pos)}
                      className={"flex-1 px-3 py-1 text-sm rounded border " + (textPosition === pos ? "bg-purple-600 text-white border-purple-600" : "bg-white text-gray-700 border-gray-300 hover:border-purple-400")}>
                      {pos}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>

        <div className="mt-4 pt-4 border-t border-gray-100">
          <label className="block text-sm font-medium text-gray-700 mb-2">Background color</label>
          <div className="flex items-center gap-2">
            <input type="color" value={bgColor} onChange={(e) => setBgColor(e.target.value)} className="w-10 h-10 rounded cursor-pointer border border-gray-300" />
            <input type="text" value={bgColor} onChange={(e) => setBgColor(e.target.value)} className="w-24 px-2 py-1 text-sm border border-gray-300 rounded font-mono" />
            <div className="flex gap-1 ml-2">
              {["#000000", "#ffffff", "#1a1a1a", "#ff0000", "#0066ff"].map((c) => (
                <button key={c} onClick={() => setBgColor(c)} className="w-6 h-6 rounded border border-gray-300" style={{ backgroundColor: c }} aria-label={"Background " + c} />
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="mt-6 bg-white border border-gray-200 rounded-xl p-6">
        <h3 className="font-bold mb-4">Export</h3>
        <div className="space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Format and quality</label>
            <div className="flex flex-wrap items-center gap-3">
              <div className="flex rounded-lg border border-gray-300 overflow-hidden">
                <button onClick={() => setFormat("png")} className={"px-4 py-1.5 text-sm " + (format === "png" ? "bg-purple-600 text-white" : "bg-white text-gray-700 hover:bg-gray-50")}>PNG</button>
                <button onClick={() => setFormat("jpeg")} className={"px-4 py-1.5 text-sm " + (format === "jpeg" ? "bg-purple-600 text-white" : "bg-white text-gray-700 hover:bg-gray-50")}>JPG</button>
              </div>
              {format === "jpeg" && (
                <div className="flex items-center gap-2">
                  <label className="text-xs text-gray-600">Quality:</label>
                  <input type="range" min={0.5} max={1} step={0.05} value={quality} onChange={(e) => setQuality(Number(e.target.value))} className="w-24" />
                  <span className="text-xs font-mono w-10">{Math.round(quality * 100)}%</span>
                </div>
              )}
            </div>
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Export sizes</label>
            <div className="flex flex-wrap gap-2">
              {PLATFORMS.map((p) => {
                const active = selectedPlatforms.includes(p.id);
                return (
                  <button key={p.id} onClick={() => togglePlatform(p.id)}
                    className={"px-3 py-2 text-sm rounded-lg border " + (active ? "bg-purple-600 text-white border-purple-600" : "bg-white text-gray-700 border-gray-300 hover:border-purple-400")}>
                    <div className="font-medium">{p.name}</div>
                    <div className="text-xs opacity-80">{p.width}x{p.height}</div>
                  </button>
                );
              })}
            </div>
          </div>

          <button onClick={handleDownloadAll} disabled={processing || selectedPlatforms.length === 0}
            className="w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-bold rounded-lg hover:opacity-90 disabled:opacity-50 transition">
            {processing ? "Exporting..." : "Download " + platformLabel + " (" + format.toUpperCase() + ")"}
          </button>
        </div>
      </div>

      <div className="mt-6 grid sm:grid-cols-3 gap-3 text-center text-sm">
        <div className="bg-blue-50 border border-blue-100 rounded-lg p-3">
          <div className="font-bold text-blue-900">1280x720</div>
          <div className="text-blue-700 text-xs">YouTube recommended</div>
        </div>
        <div className="bg-green-50 border border-green-100 rounded-lg p-3">
          <div className="font-bold text-green-900">{format.toUpperCase()}</div>
          <div className="text-green-700 text-xs">{format === "jpeg" ? Math.round(quality * 100) + "% quality" : "Lossless"}</div>
        </div>
        <div className="bg-purple-50 border border-purple-100 rounded-lg p-3">
          <div className="font-bold text-purple-900">{selectedPlatforms.length}</div>
          <div className="text-purple-700 text-xs">size{selectedPlatforms.length !== 1 ? "s" : ""}</div>
        </div>
      </div>
    </div>
  );
}